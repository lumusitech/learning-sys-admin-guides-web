---
import type { NavEntry } from '../lib/nav';

interface Props {
  prev?: NavEntry;
  next?: NavEntry;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav
      aria-label="Página anterior y siguiente"
      class="mt-12 flex flex-col items-stretch gap-2 border-t border-line pt-4 sm:flex-row"
    >
      {prev ? (
        <a
          href={prev.href}
          class="flex min-h-14 w-full min-w-0 flex-col justify-center rounded-xl border border-line bg-surface px-4 py-2 hover:border-accent sm:flex-1"
        >
          <span class="text-[11px] uppercase tracking-wide text-muted">Anterior</span>
          <span class="break-words text-sm font-semibold text-fg">{prev.title}</span>
        </a>
      ) : (
        <span class="hidden flex-1 sm:block" />
      )}

      {next ? (
        <a
          href={next.href}
          class="flex min-h-14 w-full min-w-0 flex-col justify-center rounded-xl border border-line bg-surface px-4 py-2 hover:border-accent sm:flex-1 sm:items-end sm:text-right"
        >
          <span class="text-[11px] uppercase tracking-wide text-muted">Siguiente</span>
          <span class="break-words text-sm font-semibold text-fg">{next.title}</span>
        </a>
      ) : (
        <span class="hidden flex-1 sm:block" />
      )}
    </nav>
  )
}
