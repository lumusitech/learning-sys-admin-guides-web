---
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length > 1 && (
    <aside data-toc class="toc-desktop hidden lg:block" aria-label="Contenido de la página">
      <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pr-2">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-wide text-muted">
          En esta página
        </p>
        <ul class="border-l border-line text-sm">
          {items.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                data-toc-link
                class:list={[
                  'block border-l-2 border-transparent py-1 pl-3 text-muted transition-colors hover:text-fg',
                  heading.depth === 3 && 'pl-6',
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  )
}

<style>
  :global([data-toc-link][data-active='true']) {
    border-left-color: var(--c-accent);
    color: var(--c-fg);
    font-weight: 600;
  }
</style>
