---
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  variant?: 'mobile' | 'desktop';
}

const { headings, variant = 'desktop' } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length > 1 && variant === 'mobile' && (
    <details class="toc-mobile mb-6 rounded-xl border border-line bg-surface lg:hidden">
      <summary class="flex min-h-11 cursor-pointer items-center gap-2 px-4 text-sm font-semibold">
        <span class="text-[10px] text-accent">▸</span>
        En esta página
      </summary>
      <ul class="border-t border-line px-4 py-3 text-sm">
        {items.map((heading) => (
          <li class:list={[heading.depth === 3 && 'ml-3']}>
            <a href={`#${heading.slug}`} class="block min-h-9 py-1 text-muted hover:text-fg">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

{
  items.length > 1 && variant === 'desktop' && (
    <aside data-toc class="toc-desktop hidden lg:block" aria-label="Contenido de la página">
      <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pr-2">
        <p class="mb-2 text-[11px] font-semibold uppercase tracking-wide text-muted">
          En esta página
        </p>
        <ul class="border-l border-line text-sm">
          {items.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                data-toc-link
                class:list={[
                  'block border-l-2 border-transparent py-1 pl-3 text-muted transition-colors hover:text-fg',
                  heading.depth === 3 && 'pl-6',
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  )
}

<style>
  .toc-mobile > summary {
    list-style: none;
  }

  .toc-mobile > summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile[open] > summary > span:first-child {
    transform: rotate(90deg);
    display: inline-block;
  }

  :global([data-toc-link][data-active='true']) {
    border-left-color: var(--c-accent);
    color: var(--c-fg);
    font-weight: 600;
  }
</style>
