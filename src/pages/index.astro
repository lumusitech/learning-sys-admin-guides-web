---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNav } from '../lib/nav';
import { base } from '../lib/base';

const nav = await getNav();

const sectionMeta: Record<string, { tone: string; hint: string }> = {
  guides: { tone: 'text-accent', hint: 'Herramientas explicadas en profundidad' },
  scenarios: { tone: 'text-accent', hint: 'Problemas reales resueltos paso a paso' },
  concepts: { tone: 'text-accent', hint: 'Modelos mentales para pensar como SRE' },
  reference: { tone: 'text-accent', hint: 'Tablas de consulta rápida' },
  labs: { tone: 'text-accent', hint: 'Entornos Docker para practicar' },
};

const total = nav.reduce(
  (sum, group) => sum + group.items.length + group.subgroups.reduce((n, sub) => n + sub.items.length, 0),
  0,
);
---

<BaseLayout title="Inicio">
  <main id="contenido" class="mx-auto max-w-6xl px-4">
    <section class="py-12 lg:py-20">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-accent">
        Sistema de entrenamiento
      </p>
      <h1 class="max-w-3xl text-3xl font-bold leading-tight tracking-tight lg:text-5xl">
        No coleccionamos comandos.<br />
        Construimos un sistema para pensar como sysadmin.
      </h1>
      <p class="mt-5 max-w-2xl text-base text-muted lg:text-lg">
        Guías, escenarios y labs ordenados por progresión didáctica. Pensado para estudiar desde el
        celular, sin zoom y sin perder el hilo.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={`${base}concepts/how-to-think-like-sysadmin/`}
          class="inline-flex min-h-11 items-center rounded-lg bg-accent px-4 text-sm font-semibold text-black"
        >
          Empezar por el modelo mental
        </a>
        <a
          href={`${base}scenarios/system/15-config-drift/`}
          class="inline-flex min-h-11 items-center rounded-lg border border-line px-4 text-sm font-semibold text-fg hover:border-accent"
        >
          Ir a un escenario
        </a>
      </div>
      <p class="mt-6 text-xs text-muted">{total} documentos disponibles</p>
    </section>

    <section class="pb-16">
      <h2 class="mb-5 text-sm font-semibold uppercase tracking-wide text-muted">Secciones</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          nav.map((group) => {
            const count =
              group.items.length + group.subgroups.reduce((n, sub) => n + sub.items.length, 0);
            const preview = [
              ...group.items.slice(0, 3),
              ...group.subgroups.flatMap((sub) => sub.items.slice(0, 1)),
            ].slice(0, 4);

            return (
              <article class="rounded-2xl border border-line bg-surface p-5">
                <div class="mb-2 flex items-baseline justify-between gap-3">
                  <h3 class="text-lg font-semibold">{group.label}</h3>
                  <span class="text-xs text-muted">{count}</span>
                </div>
                <p class="mb-4 text-sm text-muted">{sectionMeta[group.section]?.hint ?? ''}</p>
                <ul class="space-y-1 text-sm">
                  {preview.map((item) => (
                    <li>
                      <a href={item.href} class="block min-h-9 truncate py-1 text-fg/80 hover:text-accent">
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })
        }
      </div>
    </section>
  </main>
</BaseLayout>
