---
import '../styles/global.css';
import SearchBar from '../components/SearchBar.astro';
import SidebarNav from '../components/SidebarNav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import TocMenu from '../components/TocMenu.astro';
import type { Heading } from '../components/Toc.astro';
import { getAllEntries, getNav } from '../lib/nav';
import { base } from '../lib/base';

interface Props {
  title: string;
  description?: string;
  currentId?: string;
  headings?: Heading[];
}

const {
  title,
  description = 'Sistema de entrenamiento para pensar como sysadmin/SRE. Guías, escenarios y labs en un solo lugar.',
  currentId = '',
  headings = [],
} = Astro.props;

const nav = await getNav();
const entries = await getAllEntries();
const pageTitle = title === 'Inicio' ? 'sysadmin.guides' : `${title} · sysadmin.guides`;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d10" />
    <script is:inline>
      (() => {
        const params = new URLSearchParams(location.search);
        const forced = params.get('theme');
        const stored = localStorage.getItem('theme');
        const theme = forced === 'light' || forced === 'dark' ? forced : stored === 'light' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{pageTitle}</title>

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* sin acceso a localStorage */
        }
      })();
    </script>
  </head>

  <body class="min-h-dvh bg-bg text-fg antialiased">
    <a href="#contenido" class="skip-link">Saltar al contenido</a>

    <div class="reading-progress" data-progress aria-hidden="true"></div>

    <header class="sticky top-0 z-50 border-b border-line bg-bg/90 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center gap-2 px-3">
        <button
          type="button"
          data-drawer-toggle
          aria-expanded="false"
          aria-controls="drawer-nav"
          aria-label="Abrir navegación"
          class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-line text-muted hover:text-fg lg:hidden"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <a href={base} class="flex min-h-11 min-w-0 items-center gap-2 font-semibold tracking-tight">
          <span class="inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          <span class="truncate">sysadmin<span class="text-accent">.guides</span></span>
        </a>

        <div class="ml-auto flex items-center gap-2">
          <TocMenu headings={headings} />
          <SearchBar items={entries} />
          <ThemeToggle />
        </div>
      </div>
    </header>

    <div id="drawer-nav" data-drawer data-open="false" class="drawer lg:hidden">
      <div class="drawer-backdrop" data-drawer-close></div>
      <aside class="drawer-panel">
        <div class="mb-4 flex items-center justify-between">
          <span class="text-sm font-semibold">Navegación</span>
          <button
            type="button"
            data-drawer-close
            aria-label="Cerrar navegación"
            class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-line text-muted hover:text-fg"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </div>
        <SidebarNav nav={nav} currentId={currentId} />
      </aside>
    </div>

    <slot />

    <footer class="mt-16 border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-sm text-muted">
        <p>
          Proyecto educativo. Construido para estudiar administración de sistemas desde el celular.
        </p>
        <p class="text-xs">
          Fuente original en Markdown · <span class="text-fg">learning-sys-admin-guides</span>
        </p>
      </div>
    </footer>

    <script>
      import '../scripts/enhance';
    </script>

    <style>
      .drawer {
        position: fixed;
        inset: 0;
        z-index: 40;
      }

      .drawer[data-open='false'] {
        display: none;
      }

      .drawer-backdrop {
        position: absolute;
        inset: 0;
        background: rgb(0 0 0 / 0.6);
      }

      .drawer-panel {
        position: absolute;
        inset-block: 0;
        left: 0;
        width: min(85%, 20rem);
        overflow-y: auto;
        border-right: 1px solid var(--c-line);
        background: var(--c-bg);
        padding: 1rem;
      }
    </style>
  </body>
</html>
