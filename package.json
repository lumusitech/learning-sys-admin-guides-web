{
  "name": "learning-sys-admin-guides-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "description": "Sitio de estudio mobile-first para administración de servidores Linux y redes",
  "scripts": {
    "dev": "pnpm search:index && astro dev",
    "build": "pnpm search:index && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "lint:icons": "node scripts/lint-icons.mjs",
    "lint:language": "node scripts/lint-language.mjs",
    "lint:content": "node scripts/lint-content.mjs",
    "sync:allowlist": "node scripts/sync-allowlist.mjs",
    "search:index": "node scripts/build-search-index.mjs",
    "content": "node scripts/prepare-content.mjs",
    "sync": "node scripts/sync-content.mjs",
    "migrate:content": "node scripts/migrate-content.mjs",
    "new:guide": "node scripts/new-guide.mjs",
    "verify": "pnpm lint:icons && pnpm lint:language && pnpm check && pnpm build && pnpm lint:content && pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.16",
    "astro": "^7.4.13",
    "github-slugger": "^2.0.0",
    "mermaid": "^12.3.0",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "hast-util-to-html": "^9.0.7",
    "mdast-util-to-hast": "^13.2.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
